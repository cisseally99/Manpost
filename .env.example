DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/manpost?schema=public"
APP_URL="http://localhost:3000"

# Optional error monitoring. Create a Sentry project and set its DSN here.
# The DSN is a public ingestion identifier; never put SENTRY_AUTH_TOKEN here.
NEXT_PUBLIC_SENTRY_DSN=""

# Optional locally: Manpost uses a process-local limiter in development.
# Required in production so limits are shared across Vercel function instances.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# SMTP is optional for local development. Without it, Manpost shows a local-only
# reset link after requesting a password reset. Configure all SMTP values to send email.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
